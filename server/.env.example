# Copy this file to .env and fill in your values.

# PostgreSQL connection. Create the database first, e.g.:  createdb sales_hub
DATABASE_URL=postgres://postgres:YOUR_PASSWORD@localhost:5432/sales_hub
# Cloud databases: DATABASE_SSL=true (verify certificate) or no-verify. Optional DATABASE_CA_FILE=path/to/ca.pem
DATABASE_SSL=false

# Long random string used to sign session cookies. Change it!
JWT_SECRET=change-me-to-a-long-random-string

PORT=4000

# Production: NODE_ENV=production. Behind a reverse proxy (IIS/nginx/load balancer) set TRUST_PROXY to the number
# of proxies (usually 1) so real client IPs are used for rate limits and the activity log.
# NODE_ENV=production
# TRUST_PROXY=1

# Backups (npm run backup): where to write them and how many to keep. PG_DUMP = full path if not found automatically.
# BACKUP_DIR=../backups
# BACKUP_KEEP=14

# Public URL of the React app; used to build password reset / invite links.
APP_URL=http://localhost:5173

# Where uploaded files are stored (relative to the server folder).
UPLOAD_DIR=uploads

# Accounts created by `npm run db:init` (only if the users table is empty).
SEED_ADMIN_EMAIL=admin@company.com
SEED_ADMIN_PASSWORD=ChangeMe-Admin1
SEED_REP_PASSWORD=ChangeMe-Rep1

# Email (password reset links and new-user invites), as in QMAS.
# 'log' prints emails in the server console and sends nothing; 'graph' sends through Outlook
# (Microsoft 365, OAuth); 'smtp' sends through any SMTP server.
# SMTP examples: Office 365 smtp.office365.com:587 (password SMTP is being retired by Microsoft),
# Gmail smtp.gmail.com:587 with an app password.
# AWS SES: email-smtp.<region>.amazonaws.com, port 587. Check the settings with: npm run check-mail -w server
MAIL_TRANSPORT=log
MAIL_FROM=Western Sales Hub <no-reply@example.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
# --- Outlook / Microsoft 365 (recommended): MAIL_TRANSPORT=graph ---
# Sends with OAuth through Microsoft Graph, so it keeps working after Microsoft switches off
# password SMTP (off by default from end of December 2026). Needs an Entra app registration with the
# Microsoft Graph *application* permission Mail.Send (admin consent) and a client secret.
# MAIL_FROM must be a real mailbox in your tenant, e.g. Western Sales Hub <saleshub@yourcompany.com>.
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=

# Testing only: deliver every email to this address instead (the subject names the intended recipient).
MAIL_REDIRECT_TO=
