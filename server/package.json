{
  "name": "western-sales-hub-server",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "src/index.js",
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/index.js",
    "start": "node --env-file-if-exists=.env src/index.js",
    "db:init": "node --env-file-if-exists=.env scripts/init-db.js",
    "db:reset": "node --env-file-if-exists=.env scripts/init-db.js --reset",
    "check-mail": "node --env-file-if-exists=.env scripts/check-mail.js",
    "backup": "node --env-file-if-exists=.env scripts/backup.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/**/*.test.js\""
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cookie-parser": "^1.4.7",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.5",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.13",
    "pg": "^8.16.3"
  }
}
