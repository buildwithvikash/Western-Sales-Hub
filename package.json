{
  "name": "western-sales-hub",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c green,yellow \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "db:init": "npm run db:init -w server",
    "db:reset": "npm run db:reset -w server",
    "backup": "npm run backup -w server",
    "test": "npm test -w server"
  },
  "devDependencies": {
    "concurrently": "^9.2.1"
  }
}
